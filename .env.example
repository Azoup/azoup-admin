# Copie para `.env` na RAIZ do projeto (mesma pasta que package.json)
# Expo carrega automaticamente variáveis EXPO_PUBLIC_* ao iniciar.

# Supabase (painel React Native — use apenas URL + chave ANON/PUBLIC)
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# ⚠️ NÃO coloque STRIPE_SECRET_KEY, SERVICE ROLE nem GOOGLE_CLIENT_SECRET no git.
# Google Calendar: configure no Supabase → Edge Functions → Secrets
# (ou guarde só no seu .env local, que está no .gitignore).
# Ver docs/google-calendar.md
#
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=seu-client-secret
# GOOGLE_REDIRECT_URI=https://SEU_PROJETO.supabase.co/functions/v1/google-calendar/oauth_callback
# PAINEL_PUBLIC_URL=http://localhost:8081
